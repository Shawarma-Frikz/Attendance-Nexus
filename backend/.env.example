# Copy this file to .env and use a mail provider's SMTP credentials.
INSTRUCTOR_USERNAME=teacher
INSTRUCTOR_PASSWORD=
INSTRUCTOR_SESSION_HOURS=12
COOKIE_SECURE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@example.com
SMTP_PASSWORD=your-provider-app-password
SMTP_FROM=NEXUS Attendance <your-sender@example.com>
SMTP_STARTTLS=true
# Replace this sample address with the computer's current Wi-Fi/LAN address.
STUDENT_LOGIN_URL=http://192.168.1.140:3000/student
STUDENT_RESET_URL=http://192.168.1.140:3000/student/reset
